{
  "name": "pip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "安静的打卡日历。只给自己和几个朋友用。",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
